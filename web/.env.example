# Planning Center Services — Personal Access Token
# Create one at https://api.planningcenteronline.com/oauth/applications  → "Personal Access Tokens"
# Copy this file to `.env` and fill in. These stay server-side (Vite dev proxy); they are
# NEVER bundled into the browser app.
PCO_APP_ID=
PCO_SECRET=

# Optional: pin a specific Service Type id (otherwise the first one is used).
# This one IS visible to the client (not a secret), hence the VITE_ prefix.
VITE_PCO_SERVICE_TYPE_ID=

# Optional: expose the Vite dev server beyond this machine. Leave blank for localhost.
# Do not set this on an untrusted network when PCO_APP_ID / PCO_SECRET are configured.
VITE_DEV_HOST=
